# --- hy_recap configuration -------------------------------------------------
# Copy to `.env` (git-ignored) or export these in your scheduler. Never commit
# real keys.

# Which backend serves each section: "sample" (synthetic preview) or "rest"
# (your JSON gateway). Extend with vendor adapters in sources/registry.py.
HY_MACRO_SOURCE=sample
HY_BOND_SOURCE=sample
HY_NEWS_SOURCE=sample
HY_OUTLOOK_SOURCE=sample

# Generic REST gateway you control that proxies your licensed data
# (Bloomberg / ICE / FINRA TRACE). See hy_recap/sources/feeds.py for the
# expected JSON contract.
# HY_REST_BASE_URL=https://your-feed.internal/hy
# HY_REST_API_KEY=

# Vendor credentials (only needed if you add vendor-direct adapters).
# BLOOMBERG_HOST=localhost
# BLOOMBERG_PORT=8194
# ICE_API_KEY=
# FINRA_TRACE_API_KEY=

# Report shape
HY_INDEX_NAME=ICE BofA US High Yield
HY_TOP_N=5

# Output & delivery
HY_OUTPUT_DIR=./output/hy_recap
HY_DELIVERY_TZ=America/New_York
HY_DELIVERY_DEADLINE=07:15

# Google Drive delivery (service account). Install: pip install -r requirements-drive.txt
# Share the target Drive folder with the service account's email as Editor.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# HY_DRIVE_FOLDER_ID=
# HY_DRIVE_AS_DOC=false   # true = convert Markdown into a native Google Doc
